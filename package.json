{
  "name": "deep-research-engine",
  "version": "1.0.0",
  "description": "Production-ready Deep Research Engine — Perplexity-like backend using only free/open-source tools",
  "author": "Deep Research Engine",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:node": "ts-node-dev --respawn --transpile-only --files src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "docker:build": "docker build -t deep-research-engine .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app"
  },
  "keywords": [
    "research-engine",
    "perplexity",
    "duckduckgo",
    "fastify",
    "redis",
    "bullmq",
    "typescript",
    "web-scraper",
    "nlp",
    "summarization"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bullmq": "^5.0.0",
    "cheerio": "^1.0.0",
    "compromise": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.4",
    "express-rate-limit": "^6.8.0",
    "ioredis": "^5.0.0",
    "natural": "^7.0.0",
    "p-limit": "^3.1.0",
    "p-timeout": "^5.0.0",
    "pino": "^8.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.19",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^1.0.0",
    "pino-pretty": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
