# ============================================================
# Deep Research Engine - Environment Variables
# ============================================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache Settings
CACHE_TTL_SECONDS=21600        # 6 hours for query results
PAGE_CACHE_TTL_SECONDS=86400   # 24 hours for scraped pages

# Rate Limiting
RATE_LIMIT_MAX=20              # Max requests per window
RATE_LIMIT_WINDOW_MS=60000     # Window in ms (1 minute)

# Queue / BullMQ
QUEUE_CONCURRENCY=5            # Parallel scraping jobs
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=2000

# Scraping
SCRAPER_TIMEOUT_MS=15000       # Per-page timeout
SCRAPER_MAX_URLS=25            # Max URLs to scrape per query
SCRAPER_USE_BROWSER=false      # true = Puppeteer, false = Cheerio+axios

# Search
SEARCH_RESULTS_LIMIT=30        # DuckDuckGo results to fetch

# AI / Summarization
SUMMARY_MAX_SENTENCES=5        # Extractive summary sentences
KEY_POINTS_COUNT=5             # Number of key points to extract
MAX_CONTENT_LENGTH=10000       # Max chars per scraped page

# Logging
LOG_LEVEL=info                 # trace | debug | info | warn | error

# Security
ALLOWED_HOSTS=                 # Comma-separated allowed domains (leave empty for all public)
